#!/usr/bin/env node

exports.initTimeStartTime = process.hrtime()

const semver = require('semver')

// Load v8-compile-cache for Node.js versions below 20.
// v8-compile-cache speeds up subsequent script executions by caching the compiled
// bytecode generated by V8. This reduces startup time for CLI applications.
// We disable it for Node.js 20+ to avoid issues loading ESM modules.
// There is an open issue related to that here: https://github.com/zertosh/v8-compile-cache/issues/41
// and a not merged PR that would fix it: https://github.com/zertosh/v8-compile-cache/pull/47
if (semver.lt(process.versions.node, '20.0.0')) {
  require('v8-compile-cache')
}

// For Node.js versions 22.8.0 and above, enable the built-in compile cache,
// which provides similar functionality to v8-compile-cache.
// PR for the feature: https://github.com/nodejs/node/pull/54501
if (semver.gte(process.versions.node, '22.8.0')) {
  const module = require('node:module')
  module.enableCompileCache()
}

// `--path <dir>` runs any command as if started in <dir> (like `git -C`), so
// scripts don't need `cd <app> && vtex …`. Only arguments before `--` count.
const argsEnd = process.argv.includes('--') ? process.argv.indexOf('--') : process.argv.length
const pathIndex = process.argv.slice(0, argsEnd).findIndex(arg => arg === '--path' || arg.startsWith('--path='))
if (pathIndex !== -1) {
  const [flag] = process.argv.splice(pathIndex, 1)
  const dir = flag === '--path' ? process.argv.splice(pathIndex, 1)[0] : flag.slice('--path='.length)
  try {
    process.chdir(dir)
  } catch (err) {
    console.error(`--path: cannot use "${dir}": ${err.code || err.message}`)
    process.exit(1)
  }
}

// `vtex login --local` keeps the login in the git repository's root `.vtex/`, where every folder below
// finds it from then on. The CLI folder is resolved once, as modules load, so it is set here first.
if (process.argv[2] === 'login' && process.argv.includes('--local')) {
  const repoRoot = require('../lib/lib/repoRoot').findRepoRoot(process.cwd())
  if (!repoRoot) {
    console.error('--local: not inside a git repository')
    process.exit(1)
  }
  process.env.VTEX_HOME = require('path').join(repoRoot, '.vtex')
}

if (require.main === module) {
  require('../lib/lib/unrefLogClientTimer').unrefLogClientTimer()
  require('@oclif/command')
    .run()
    .then(require('@oclif/command/flush'))
    .catch(require('@oclif/errors/handle'))
}
